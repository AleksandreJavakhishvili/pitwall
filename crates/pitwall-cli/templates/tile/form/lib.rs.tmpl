//! {{name}}: a form. The user fills in a title and a note and saves it;
//! saved notes are listed below, signed with the "Signed as" setting. An
//! agent can open the tile with a draft (input.schema.json) for the user to
//! review and save.

use pitwall_extension::prelude::*;
use serde::{Deserialize, Serialize};

/// A draft the tile is opened with (input.schema.json).
#[derive(Deserialize)]
struct Draft {
    title: Option<String>,
    body: Option<String>,
}

#[derive(Clone, Serialize, Deserialize)]
struct Note {
    title: String,
    body: String,
    by: String,
}

#[derive(Default)]
struct Form {
    title: String,
    body: String,
    error: Option<String>,
    notes: Vec<Note>,
}

impl Tile for Form {
    fn new(_cx: &mut Cx<Self>) -> Self {
        let notes = storage::get_json("notes").ok().flatten().unwrap_or_default();
        Form { notes, ..Form::default() }
    }

    fn on_content(&mut self, view: &ViewInfo, _cx: &mut Cx<Self>) {
        let Some(content) = &view.content else { return };
        match content.parse::<Draft>() {
            Ok(d) => {
                self.title = d.title.unwrap_or_default();
                self.body = d.body.unwrap_or_default();
                self.error = None;
            }
            Err(e) => log::warn(e.to_string()),
        }
    }

    fn render(&mut self, _view: &str, cx: &mut Cx<Self>) -> impl IntoElement {
        let author = settings::text("author").unwrap_or_else(|| "me".into());
        v_flex()
            .size_full()
            .gap_2()
            .p_3()
            .child(text("New note").font_semibold())
            .child(input("title").placeholder("Title").value(self.title.clone()).on_change(cx.listener(|this, v: &str, _| this.title = v.to_string())).on_submit(cx.listener(|this, _, cx| {
                this.save();
                cx.notify();
            })))
            .child(input("body").placeholder("Note").multiline().rows(4).value(self.body.clone()).on_change(cx.listener(|this, v: &str, _| this.body = v.to_string())))
            .when_some(self.error.clone(), |form, e| form.child(text(e).id("error").text_sm().text_color(Token::Bad)))
            .child(
                h_flex()
                    .gap_2()
                    .child(button("Save").primary().on_click(cx.listener(|this, _, cx| {
                        this.save();
                        cx.notify();
                    })))
                    .child(text(format!("Signed as {author}")).text_sm().text_color(Token::Text3)),
            )
            .child(
                v_flex()
                    .id("notes")
                    .flex_1()
                    .gap_1()
                    .overflow_y_scroll()
                    .children(self.notes.iter().enumerate().rev().map(|(i, n)| {
                        v_flex()
                            .id(format!("note-{i}"))
                            .p_2()
                            .border_1()
                            .border_color(Token::Line)
                            .rounded_md()
                            .child(text(n.title.clone()).font_medium())
                            .when(!n.body.is_empty(), |c| c.child(text(n.body.clone()).text_sm().text_color(Token::Text2)))
                            .child(text(format!("by {}", n.by)).text_xs().text_color(Token::Text3))
                    })),
            )
    }
}

impl Form {
    fn save(&mut self) {
        let title = self.title.trim().to_string();
        if title.is_empty() {
            self.error = Some("Give it a title.".into());
            return;
        }
        let by = settings::text("author").unwrap_or_else(|| "me".into());
        self.notes.push(Note { title, body: self.body.trim().to_string(), by });
        if let Err(e) = storage::set_json("notes", &self.notes) {
            self.error = Some(format!("It wasn't saved: {e}"));
            return;
        }
        (self.title, self.body, self.error) = (String::new(), String::new(), None);
        ui::toast("Saved", Tone::Good);
    }
}

pitwall_extension::export!(Form);
