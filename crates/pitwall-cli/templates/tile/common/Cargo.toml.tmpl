[package]
name = "{{id}}"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
# A WebAssembly component: `pitwall extension dev` (or `cargo build
# --release --target wasm32-wasip2`) builds it, and Pitwall runs the copy
# beside extension.json, tile.wasm.
crate-type = ["cdylib"]

[dependencies]
# The SDK. Until it is on crates.io it comes from Pitwall's repository:
# this line and pitwall-extension-test's below are the two to change
# (later: pitwall-extension = "0.1").
{{sdk_dep}}
serde = { version = "1", features = ["derive"] }

[dev-dependencies]
# Runs the built tile.wasm in Pitwall's own tile runtime (tests/).
{{harness_dep}}
serde_json = "1"

# Small and quick to load: Pitwall compiles the component on first start.
[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
panic = "abort"
strip = true

# A project of its own, even inside another Cargo workspace's folder.
[workspace]
