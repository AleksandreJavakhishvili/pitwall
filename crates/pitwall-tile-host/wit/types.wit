package pitwall:tile@0.1.0;

/// The UI description a tile sends, the events it gets back, and the types
/// the other interfaces share (docs/spec/tile-sdk/ui.md §3.3–3.5).
///
/// A view is drawn from a `frame`: a flat list of nodes, each naming its
/// parent by index, so a tree is one list with no recursion. Pitwall
/// compares each frame with the one before by key path and keeps what the
/// user sees (scroll position, focus, hover, text being typed) for nodes
/// whose key path stays the same.
///
/// Colours, sizes of text, fonts and corner radii are Pitwall's own
/// tokens, named by meaning, so a tile looks native in light and dark
/// themes and follows the user's appearance settings. There are no raw
/// colours in 0.1.
interface types {
  // The payloads of `fetched` and `service-changed` (net.wit, service.wit).
  use net.{fetched};
  use service.{service-info};

  /// One open view of the tile: a place in Pitwall's layout showing one
  /// of the manifest's tiles (`contributes.tiles`). Chosen by Pitwall and
  /// stable while the view is open; a tile opened once has the tile's id
  /// as its view id (for example `"main"`), and a tile opened several
  /// times (by the user, or by agents with different content) gets one
  /// view id per place. Pitwall renders each open view separately; the
  /// guest learns of each from `view-opened`.
  type view-id = string;

  /// Content given to a view when it opens or later, by the user or an
  /// agent (as Pitwall's own viewers take a file or a page). The tile's
  /// manifest declares what it accepts (`"input"`: a JSON schema in its
  /// folder); Pitwall checks the payload against it before delivering.
  record content {
    /// The caller's id for this content. A later call with the same id
    /// updates the view showing it in place instead of opening another.
    id: option<string>,
    /// The payload, as JSON text matching the tile's input schema.
    json: option<string>,
    /// Binary payload (an image, a file's bytes), when the schema says
    /// so. At most 8 MiB.
    bytes: option<list<u8>>,
    /// The agent's call that brought this content (agent-tools.md §11.3):
    /// its id, also the origin id of what it put in the tile. Answer it
    /// with `agent-tools.reply` to return problems in the input; without
    /// a reply, Pitwall tells the agent what opened and where once
    /// `handle` returns. `none`: the user opened the view.
    call: option<u64>,
    /// The tool called: a show tool the manifest declares (`tools`), or
    /// `none` for the open Pitwall gives every tile
    /// (`<extension-id>__open`), whose content is the tile's `"input"`.
    tool: option<string>,
    /// The agent that called, as Pitwall identified it (never what the
    /// agent says about itself). `none`: the user opened the view.
    /// Items are per agent: key what an agent shows by its agent id and
    /// `id`, so two agents never replace each other's.
    caller: option<caller>,
    /// The call adds to the item instead of replacing it (`"mode":
    /// "append"` in a `present` call, with the same `id`): `json` is the
    /// part to add.
    append: bool,
    /// The call named a file instead of inline text (`"from_file"`): its
    /// size in bytes, read in parts with `agent-tools.input-part` while
    /// the event is handled.
    large: option<u64>,
  }

  /// An agent calling a tile's tool, as Pitwall identified it from the
  /// calling process.
  record caller {
    /// The agent's id in Pitwall (stable while the agent exists).
    agent-id: string,
    /// The agent's name, as the user sees it (`api`, `web`).
    agent-name: string,
    /// The agent's project folder, when it has one.
    project: option<string>,
  }

  /// A view was opened.
  record view-opened {
    /// The new view's id.
    view: view-id,
    /// Which of the manifest's tiles it shows.
    tile: string,
    /// What it was opened with, if anything.
    content: option<content>,
  }

  /// An open view was given new content.
  record view-content {
    /// The view.
    view: view-id,
    /// Its content now.
    content: content,
  }

  /// A function of the tile, by number. The tile chooses the numbers when
  /// it renders, keeps the function they stand for, and gets the number
  /// back in the event when the user acts. A number from an older frame
  /// may still arrive once after a render; a tile ignores numbers it no
  /// longer knows.
  type handler = u32;

  /// A timer, by the number `tasks.timer` gave.
  type timer-id = u32;

  /// Why a host call didn't do what was asked.
  variant host-error {
    /// The tile isn't granted the permission this needs.
    denied,
    /// Too many calls or things at once (over 200 host calls a second, or
    /// 32 timers); try again later.
    busy,
    /// Over a size limit or a quota; the limits are in each function's
    /// documentation.
    too-large,
    /// An argument isn't valid; the text says which and why.
    invalid(string),
    /// The host couldn't do it (for example a disk error); the text says
    /// what happened.
    failed(string),
  }

  /// A colour of Pitwall's theme, by meaning. Each has a light and a dark
  /// value; the user's theme decides which is drawn.
  enum token {
    /// The window's background, behind tiles.
    bg,
    /// A tile's own background.
    surface,
    /// A raised area inside a tile: a header, a selected row.
    surface-2,
    /// A further raised area: a hovered selected row, a field.
    surface-3,
    /// Floating surfaces: menus, popovers.
    raised,
    /// Hairlines and borders.
    line,
    /// Stronger borders: a focused field, a divider that must be seen.
    line-strong,
    /// Main text.
    text,
    /// Secondary text: details, labels.
    text-2,
    /// Muted text: hints, timestamps.
    text-3,
    /// Faint text: placeholders, disabled.
    text-4,
    /// The focus ring.
    focus,
    /// Success: passed, running well.
    good,
    /// A soft background for good things.
    good-soft,
    /// Needs attention.
    warn,
    /// A soft background for warnings.
    warn-soft,
    /// Failed, destructive.
    bad,
    /// A soft background for failures.
    bad-soft,
    /// Finished.
    done,
    /// A soft background for finished things.
    done-soft,
    /// The background of an added line in a diff.
    diff-add-bg,
    /// The background of a removed line in a diff.
    diff-del-bg,
  }

  /// A length.
  variant length {
    /// Logical pixels (they scale with the display).
    px(f32),
    /// Multiples of Pitwall's base text size, so the length follows the
    /// user's font size.
    rem(f32),
    /// A fraction of the parent's size, from 0.0 to 1.0.
    fraction(f32),
    /// Whatever the content needs.
    auto,
  }

  /// A length for each side, for padding, margin and borders.
  record edges {
    /// The top side.
    top: length,
    /// The right side.
    right: length,
    /// The bottom side.
    bottom: length,
    /// The left side.
    left: length,
  }

  /// Pitwall's text sizes.
  enum text-size {
    /// The smallest: badges, counts.
    xs,
    /// Small: details, labels.
    sm,
    /// The body size.
    md,
    /// Headings inside a tile.
    lg,
    /// Large headings.
    xl,
  }

  /// Pitwall's fonts.
  enum font {
    /// The interface font.
    ui,
    /// The monospace font, for code and numbers that line up.
    mono,
  }

  /// Text weight.
  enum weight {
    /// Regular text.
    normal,
    /// Slightly heavier: labels.
    medium,
    /// Headings.
    semibold,
    /// Strong emphasis.
    bold,
  }

  /// Pitwall's corner radii.
  enum radius {
    /// Square corners.
    square,
    /// Small (4 px).
    sm,
    /// The usual radius (6 px).
    md,
    /// Large (10 px).
    lg,
    /// Fully round: pills and circles.
    full,
  }

  /// How children line up across a flex box's main direction.
  enum align {
    /// At the start.
    start,
    /// Centred.
    center,
    /// At the end.
    end,
    /// Stretched to fill.
    stretch,
    /// Along their text's baseline.
    baseline,
  }

  /// How children are spread along a flex box's main direction.
  enum justify {
    /// Packed at the start.
    start,
    /// Packed in the centre.
    center,
    /// Packed at the end.
    end,
    /// The first at the start, the last at the end, equal space between.
    space-between,
    /// Equal space around each.
    space-around,
  }

  /// What happens to content larger than its box.
  enum overflow {
    /// It shows outside the box.
    visible,
    /// It is cut off at the box's edge.
    hidden,
    /// The box scrolls (prefer the `scroll` element, which keeps its
    /// position across frames).
    scroll,
  }

  /// The pointer's shape over a node.
  enum cursor {
    /// The usual arrow.
    default,
    /// A hand: something clickable.
    pointer,
    /// A text cursor: selectable text.
    text,
  }

  /// One style of a node. A node has a list of these; a later entry wins
  /// over an earlier one of the same kind. Layout is flexbox, as in CSS.
  variant style {
    /// Lay children out in a row.
    flex-row,
    /// Lay children out in a column (the default for a box).
    flex-col,
    /// Wrap children onto more lines when they don't fit.
    wrap,
    /// Take this share of the free space along the parent's direction.
    grow(f32),
    /// Give up this share of the space when there isn't enough.
    shrink(f32),
    /// Space between children.
    gap(length),
    /// Space inside the node's border.
    padding(edges),
    /// Space outside the node's border.
    margin(edges),
    /// Width.
    width(length),
    /// Height.
    height(length),
    /// Smallest width.
    min-width(length),
    /// Largest width.
    max-width(length),
    /// Smallest height.
    min-height(length),
    /// Largest height.
    max-height(length),
    /// How children line up across the main direction.
    align-items(align),
    /// How children are spread along the main direction.
    justify(justify),
    /// How this node lines up in its parent, over the parent's
    /// `align-items`.
    self-align(align),
    /// Horizontal overflow.
    overflow-x(overflow),
    /// Vertical overflow.
    overflow-y(overflow),
    /// Border widths (in px or rem; fractions and auto count as none).
    border(edges),
    /// Border colour.
    border-color(token),
    /// Corner radius.
    radius(radius),
    /// Background colour.
    background(token),
    /// Text and icon colour, inherited by children.
    color(token),
    /// Opacity, from 0.0 (invisible) to 1.0.
    opacity(f32),
    /// Text size, inherited by children.
    text-size(text-size),
    /// Font, inherited by children.
    font(font),
    /// Text weight, inherited by children.
    weight(weight),
    /// Italic text.
    italic,
    /// Underlined text.
    underline,
    /// One line, cut with an ellipsis when too long.
    truncate,
    /// At most this many lines, the last one cut with an ellipsis.
    line-clamp(u8),
    /// The user can select and copy this text.
    selectable,
    /// Background while the pointer is over the node.
    hover-background(token),
    /// The pointer's shape over the node.
    cursor(cursor),
    /// Names this node a hover group, for `visible-on-group-hover` in the
    /// nodes under it (a list row and its actions). Names are the tile's
    /// own; the same name on several rows is fine: each node looks at its
    /// nearest ancestor of that name.
    group(string),
    /// Hidden until the pointer is over the nearest ancestor `group` of
    /// this name (a Delete on a list row that shows on hover). Pitwall
    /// draws it on hover with no call into the tile; while hidden it takes
    /// no clicks. Keyboard users reach it as usual (show it while the row
    /// has focus if it matters).
    visible-on-group-hover(string),
    /// The user can drag this node to a node of the same view with a
    /// `drop-target` that accepts its kind. Pitwall draws the drag: a
    /// chip with the source's label under the pointer.
    drag(drag-source),
    /// Drags of the kinds it accepts can be dropped here; Pitwall marks it
    /// while one is over it and sends `dropped` with its handler.
    drop-target(drop-target),
  }

  /// A button's look, as Pitwall's own buttons.
  enum button-kind {
    /// The main action of a tile or a form; one per area.
    primary,
    /// An ordinary action: a hairline button (at `small` size: Pitwall's
    /// small row and toolbar button).
    ghost,
    /// A destructive action.
    danger,
    /// A button that looks like a link.
    link,
  }

  /// A button's size, apart from its look: any kind comes in both.
  enum button-size {
    /// The usual height (30 px).
    regular,
    /// Smaller (26 px), for rows, toolbars and a tile's bars.
    small,
  }

  /// A button. Its click arrives as a `click` event for the node's `click`
  /// listener.
  record button {
    /// The text on it.
    label: string,
    /// Its look.
    kind: button-kind,
    /// Its size.
    size: button-size,
    /// An icon before the label.
    icon: option<icon>,
    /// Drawn dimmed, and clicks aren't sent.
    disabled: bool,
  }

  /// An icon. Drawn in the node's text colour (`color` style), at the
  /// node's text size unless it has a width and height.
  variant icon {
    /// One of Pitwall's icons by name: `sidebar`, `search`, `gear`,
    /// `plus`, `x`, `send`, `stop`, `restart`, `refresh`, `trash`,
    /// `branch`, `folder`, `chevron`, `grid`, `wall`, `maximize`,
    /// `restore`, `window`, `more`, `review`, `terminal`, `file`,
    /// `expand`, `copy`, `chevron-down`, `check`, `headset`, `user`,
    /// `laptop`, `server`, `eye`, `external`, `image`, `browser`, `back`,
    /// `phone`, `inspect`, `page-right`, `page-left`, `page-below`, `pin`,
    /// `grip`, `minus`, `chevron-up`, `lock`, `alert`, `extension`,
    /// `inbox`, `bell`, `chat`, `list` (the SDK's `Icon` enum). An unknown
    /// name draws nothing; the test harness notes it.
    named(string),
  }

  /// The directions a `scroll` element scrolls in.
  enum axis {
    /// Up and down.
    vertical,
    /// Left and right.
    horizontal,
    /// Both.
    both,
  }

  /// A scrolling container: its children scroll inside it. Pitwall keeps
  /// its position by key path across frames and draws its scrollbars.
  record scroll {
    /// Which ways it scrolls.
    axis: axis,
  }

  /// A range of a text field's value, in UTF-8 byte offsets (`start` ≤
  /// `end`; equal for a bare cursor).
  record text-range {
    /// Where it starts.
    start: u32,
    /// Where it ends (exclusive).
    end: u32,
  }

  /// A text field: one line, or several (`multiline`). Its font is the
  /// node's `font` style (`mono` for code), its text size the node's
  /// `text-size`.
  ///
  /// **Pitwall owns the value.** Typing, selection, undo and IME are
  /// handled by Pitwall, so they never wait for the tile, and the text is
  /// kept by key path across frames. The tile hears about edits
  /// afterwards (`input-changed`, `input-selected`) and doesn't send the
  /// text back in each frame: `value` is `none` in a frame unless the tile
  /// wants to replace the text. So a large text (up to 1 MiB) crosses the
  /// boundary only when it changes, not in every frame.
  ///
  /// Enter submits a one-line field. In a multi-line field Enter adds a
  /// line and ⌘Enter (Ctrl+Enter off macOS) submits, as in Pitwall's own
  /// text fields; while such a field has focus, ⌘Enter is the field's and
  /// doesn't maximise the tile (ui.md §3.5).
  record input {
    /// Text to put in the field, replacing what it holds; `none` keeps
    /// what it holds (the usual case). Applied only when `revision` is
    /// newer than the revision of the user's latest edit, so a frame
    /// built before an edit arrived never undoes it. The first frame
    /// that has the field gives its starting text here.
    value: option<string>,
    /// The revision of `value`: the revision of the last `input-changed`
    /// the tile has seen (0 at first), plus one. Ignored when `value` is
    /// `none`.
    revision: u64,
    /// Where to put the cursor or selection when `value` is applied
    /// (`none`: at the end).
    selection: option<text-range>,
    /// Shown in faint text while it is empty.
    placeholder: option<string>,
    /// Several lines.
    multiline: bool,
    /// For a multi-line field, its height in lines when its node has no
    /// height style (`none`: 3). It scrolls past that.
    rows: option<u16>,
    /// Drawn dimmed and can't be edited.
    disabled: bool,
  }

  // ---- Components: lists, tables, trees, tabs, selects, menus, Markdown
  // and images (ui.md §3.3). ---------------------------------------------

  /// A list too long to send whole: the frame names how many rows there
  /// are and how tall each is, and Pitwall asks the tile for the rows it
  /// is about to show with `guest.rows`, a page at a time, as the user
  /// scrolls (runtime.md §2.7). Drawn with Pitwall's own list: only the
  /// rows in sight are laid out, so 100 000 rows scroll as smoothly as
  /// 100. A click selects a row, a double click or Enter activates it,
  /// and Up, Down, Home, End, Page Up and Page Down move the selection
  /// while the list has focus (each sends `select`).
  record virtual-list {
    /// How many rows (at most 1 000 000).
    count: u32,
    /// Each row's height, in logical pixels (12–200); every row has it.
    row-height: f32,
    /// Moves when rows Pitwall already has may be out of date: it asks
    /// for the rows in sight again, and keeps showing the old ones until
    /// they arrive, so nothing flickers.
    revision: u64,
    /// The selected rows' keys (`row.key`), drawn selected.
    selected: list<string>,
  }

  /// A row of a virtual list, table or tree, as `guest.rows` returns it.
  record row {
    /// The row's item, stable while the item is the same (an id, not
    /// its index): selection and events name it. At most 128 bytes.
    key: string,
    /// What the row shows: a small tree as in a frame (node 0 is the
    /// row's root, filling the row). Boxes, text, icons, buttons,
    /// images, context menus, badges, avatars and relative times only
    /// (no fields, scrolls or nested lists); at most 64 nodes. In a table, the root's children are
    /// the cells, one per column in order.
    nodes: list<node>,
    /// A tree's row: how deep it is (0 at the top); 0 elsewhere.
    depth: u16,
    /// A tree's row: `none` for a leaf, `some(true)` for an open branch,
    /// `some(false)` for a closed one. `none` elsewhere.
    expanded: option<bool>,
  }

  /// Which way a table column is sorted.
  enum sort-direction {
    ascending,
    descending,
  }

  /// A table's column.
  record column {
    /// Its key, unique in the table; events name it.
    key: string,
    /// Its title in the header.
    title: string,
    /// Its width in logical pixels (`none`: it shares the room left with
    /// the other columns without one). The user can drag a column's
    /// edge; Pitwall then keeps their width until this value changes,
    /// and sends `column-resized`.
    width: option<f32>,
    /// Its cells' alignment across: `start`, `center` or `end`.
    align: align,
    /// Its header can be clicked to sort (sends `sort`).
    sortable: bool,
  }

  /// A table's sort: by which column, which way.
  record sort-state {
    column: string,
    direction: sort-direction,
  }

  /// A table: a header of columns over a virtual list of rows, whose
  /// roots' children are the cells. Columns can be resized and sorted;
  /// rows are selected as in a virtual list.
  record table {
    columns: list<column>,
    /// The column sorted by and how, drawn with an arrow in its header.
    sort: option<sort-state>,
    /// The rows: count, height, revision, selection.
    rows: virtual-list,
  }

  /// A tree: a virtual list of the open nodes, flattened in order, each
  /// row with its depth and whether it is a branch (`row.depth`,
  /// `row.expanded`). Pitwall draws the indent and the disclosure
  /// chevron; a click on the chevron, Left or Right, or a double click
  /// on a branch sends `toggle`; the tile opens or closes it and renders
  /// again with the new count.
  record tree {
    rows: virtual-list,
  }

  /// One tab of a tab strip.
  record tab {
    /// Its key, sent in `select`.
    key: string,
    label: string,
    icon: option<icon>,
  }

  /// A row of tabs, drawn as Pitwall's own; the tile shows the selected
  /// one's content below it. Choosing a tab sends `select`.
  record tabs {
    items: list<tab>,
    /// The selected tab's key.
    selected: option<string>,
  }

  /// One choice of a select.
  record select-option {
    /// Its key, sent in `select`.
    key: string,
    label: string,
  }

  /// A dropdown, drawn as Pitwall's own: a button showing the choice,
  /// opening a list of the options. Choosing one sends `select`.
  record select {
    options: list<select-option>,
    /// The chosen option's key.
    selected: option<string>,
    /// Shown while nothing is chosen.
    placeholder: option<string>,
    disabled: bool,
  }

  /// A choice in a menu.
  record menu-item {
    /// Its key, sent in `select`.
    key: string,
    label: string,
    icon: option<icon>,
    /// A shortcut shown at its right, as text (`"⌘D"`). Only shown: bind
    /// the key in the frame's keymap.
    hint: option<string>,
    /// Drawn dimmed and can't be chosen.
    disabled: bool,
    /// A destructive choice, drawn in red.
    danger: bool,
  }

  /// A line of a menu.
  variant menu-entry {
    item(menu-item),
    /// A thin line between groups of items.
    separator,
  }

  /// A button that opens a menu under it, drawn by Pitwall with its own
  /// menus' look. Choosing an item sends `select`. An empty label with
  /// an icon makes a small square icon button (give the node a `label`).
  record menu-button {
    label: string,
    icon: option<icon>,
    entries: list<menu-entry>,
    disabled: bool,
  }

  /// Markdown, drawn as Pitwall's own Preview draws it (headings, lists,
  /// task lists, tables, code with highlighting, quotes), and inert: no
  /// HTML runs, no image or link is fetched. A link click is `link`
  /// (with no `link` listener, web and mail links open in the browser
  /// and others do nothing); a task's checkbox click is `toggle` with
  /// its line (with no `toggle` listener, checkboxes can't be clicked).
  /// At most 1 MiB.
  record markdown {
    text: string,
  }

  /// How an image fills its box.
  enum image-fit {
    /// Whole, as large as fits.
    contain,
    /// Filling the box, cut at the edges.
    cover,
    /// Stretched to the box.
    fill,
  }

  /// Where an image's bytes come from.
  variant image-source {
    /// A file in the extension's folder, by its path there
    /// (`"assets/logo.png"`): PNG, JPEG, GIF, WebP or SVG, at most
    /// 16 MiB.
    asset(string),
    /// Bytes the tile handed over with `ui.put-image` under this name.
    data(string),
  }

  /// An image, sized by the node's styles (without a width, as wide as
  /// its box). Images never come from the network. The node's `label`
  /// is read as its description.
  record image {
    source: image-source,
    fit: image-fit,
  }

  /// What a node is.
  variant element {
    /// A box: a flex container with no look of its own beyond its
    /// styles. The usual root.
    box,
    /// Text. A text node whose children are text nodes draws them as
    /// inline runs of one paragraph (each run with its own styles), so
    /// `"Built in "` + bold `"3 s"` wrap as one line of text.
    text(string),
    /// A button.
    button(button),
    /// An icon.
    icon(icon),
    /// A scrolling container.
    scroll(scroll),
    /// A text field.
    input(input),
    /// A drawing: shapes, lines and text the tile places itself, with
    /// clickable regions over them. Give it a size (width and height, or
    /// grow).
    canvas(canvas),
    /// Pitwall's read-only code view, with the text the tile gives:
    /// highlighting, line numbers, selection and copy, Find.
    code-view(code-view),
    /// Pitwall's diff view of two versions of a text, as Review draws it.
    diff-view(diff-view),
    /// A long list, its rows fetched as they come into sight.
    virtual-list(virtual-list),
    /// A table: columns over a virtual list of rows.
    table(table),
    /// A tree: a virtual list of the open nodes.
    tree(tree),
    /// A row of tabs.
    tabs(tabs),
    /// A dropdown.
    select(select),
    /// A button that opens a menu.
    menu-button(menu-button),
    /// The menu a right-click opens on this node's parent, drawn by
    /// Pitwall. Not drawn in place; a parent has at most one. Choosing an
    /// item sends `select` with this node's `select` handler.
    context-menu(list<menu-entry>),
    /// Markdown, drawn and inert.
    markdown(markdown),
    /// An image.
    image(image),
    /// A checkbox with its label.
    checkbox(check),
    /// A switch (an on/off toggle) with its label.
    switch(check),
    /// A group of radio buttons: one of several choices.
    radio-group(choice-group),
    /// A segmented control: one of a few choices, side by side.
    segmented(choice-group),
    /// A slider: a number in a range, dragged or moved with the keys.
    slider(slider),
    /// A number field with − and + steps.
    number-field(number-field),
    /// A search field: a text field with a magnifier and a clear button.
    search-field(search-field),
    /// A form row: a label over (or beside) the control under it, with
    /// help text, a validation message and a required mark.
    form-row(form-row),
    /// A progress bar, with a known share done or still going.
    progress(progress),
    /// A spinning ring: something is loading.
    spinner,
    /// A grey placeholder where content is loading.
    skeleton(skeleton),
    /// An empty state: an icon, a title, a line of text and an action.
    empty-state(empty-state),
    /// An inline banner: information, success, a warning or an error.
    banner(banner),
    /// A small count or status label.
    badge(badge),
    /// A chip (a tag): a label that can be picked or removed.
    chip(chip),
    /// A key or shortcut, drawn as Pitwall draws its own (`cmd-k`: ⌘K).
    kbd(string),
    /// Two panes with a bar between them the user drags.
    split(split),
    /// A section with a header that opens and closes it.
    disclosure(disclosure),
    /// A card: a bordered box, with a title.
    card(card),
    /// A thin line between things.
    divider(orientation),
    /// Breadcrumbs: where the user is, each level clickable.
    breadcrumbs(list<crumb>),
    /// A toolbar row: Pitwall's bar look for the buttons and fields in it.
    toolbar,
    /// A popover anchored to its parent node, drawn by Pitwall.
    popover(popover),
    /// A sheet over the tile asking the user to confirm.
    confirm-sheet(confirm-sheet),
    /// A list of labels and their values.
    key-values(list<key-value>),
    /// An avatar: a person's initials in a circle.
    avatar(avatar),
    /// A time drawn as "5 min ago", kept up to date by Pitwall.
    relative-time(relative-time),
    /// Text with a button that copies it.
    copyable(copyable),
    /// A link: opens a web page, or tells the tile.
    link(link),
    /// A small line chart without axes, inline with text.
    sparkline(sparkline),
    /// A bar chart.
    bar-chart(bar-chart),
    /// A line chart with axes.
    line-chart(line-chart),
    /// A row of coloured segments, one per run (CI runs, deploys).
    status-timeline(status-timeline),
  }

  /// The events a node can ask for, each with the handler it should
  /// carry.
  enum listen {
    /// A click (or Space or Enter while the node has focus). Buttons and
    /// any other node.
    click,
    /// A text field's value changed.
    change,
    /// A text field's cursor or selection moved without its value
    /// changing.
    select,
    /// Enter (⌘Enter when multi-line) in a text field.
    submit,
    /// A scroll container was scrolled (for loading more at the end).
    scroll,
    /// The pointer entered or left the node.
    hover,
    /// Pointer presses, releases and moves over the node, with their
    /// position (for drawing and dragging inside a node).
    pointer,
    /// The wheel or trackpad scrolled, or a pinch, over the node: sent as
    /// `pointer` events with the `wheel` and `pinch` kinds, carrying the
    /// `wheel` listener's handler. A node listening for it takes the
    /// wheel, so a scroll container around it doesn't scroll.
    wheel,
    /// A click on a line number of a code or diff view.
    line-click,
    /// A tree's branch opened or closed; a Markdown task's checkbox
    /// clicked.
    toggle,
    /// A link in Markdown clicked.
    link,
    /// A table's header clicked to sort.
    sort,
    /// A table's column resized by the user.
    column-resized,
    /// A control's value changed: a checkbox, switch, radio group,
    /// segmented control, slider, number field, disclosure, split,
    /// breadcrumb or status timeline (`value-changed`).
    value,
    /// The user closed or removed it: a banner, a chip, a popover, a
    /// confirm sheet's Cancel (`dismissed`).
    dismiss,
  }

  /// An event a node asks for, and the handler it should carry.
  record listener {
    /// Which event.
    on: listen,
    /// The handler it carries.
    handler: handler,
  }

  /// One node of a frame.
  record node {
    /// The parent's index in `frame.nodes`: always lower than this
    /// node's own. `none` only for the first node, the root.
    parent: option<u32>,
    /// Stable among its siblings: Pitwall matches nodes across frames by
    /// key path (the keys from the root down), so a node keeps its scroll
    /// position, focus and typed text while its key path stays the same.
    /// Unique among siblings; at most 128 bytes.
    key: string,
    /// What it is.
    element: element,
    /// How it looks and lays out.
    style: list<style>,
    /// The events it wants.
    on: list<listener>,
    /// It can take keyboard focus (Tab moves among focusable nodes in
    /// tree order). Buttons and text fields are focusable whatever this
    /// says.
    focusable: bool,
    /// Text shown when the pointer rests on it.
    tooltip: option<string>,
    /// Its accessible name, read by screen readers. Required for a button
    /// with only an icon.
    label: option<string>,
  }

  /// A key binding the tile handles while it has focus.
  ///
  /// Pitwall's own keys are reserved: a frame that binds one has that
  /// binding dropped, with a line in the tile's Log. They are `escape`,
  /// `tab`, `shift-tab`, `ctrl-enter`; `cmd-` with any of `enter`,
  /// `0`–`9`, `=`, `+`, `-`, `,`, `a`, `b`, `c`, `e`, `h`, `i`, `j`, `k`,
  /// `l`, `m`, `n`, `p`, `q`, `r`, `t`, `v`, `w`, `x`, `z`, alone or with
  /// `shift` (Pitwall's shortcuts are Ctrl+Shift off macOS); and
  /// `cmd-shift-f`, `cmd-alt-h`, `cmd-ctrl-f`, `cmd-shift-alt-` `e`, `n`,
  /// `r`, `t`. Modifiers may come in any order.
  ///
  /// While a text field of the tile has focus, a binding without `cmd`,
  /// `ctrl` or `alt` doesn't fire: the key types into the field.
  record binding {
    /// The keys, as Pitwall writes them: `j`, `enter`, `cmd-s`,
    /// `shift-tab`, `/`. `cmd` is ⌘ on macOS and Ctrl elsewhere.
    keys: string,
    /// The handler a `key` event carries when they are pressed.
    handler: handler,
  }

  /// What a view shows: its whole tree, sent after every change. At most
  /// 20 000 nodes and about 2 MiB of data; a larger frame stops the tile.
  record frame {
    /// The nodes, root first, each after its parent.
    nodes: list<node>,
    /// The key path (keys from the root down, joined by `/`, without the
    /// root's) of the node the tile wants focused. Honoured only while
    /// the tile already has focus, so a tile can't take the keyboard from
    /// a terminal.
    focus: option<string>,
    /// The keys the tile handles while it has focus.
    keymap: list<binding>,
  }

  /// Keys held during a click.
  flags modifiers {
    /// Shift.
    shift,
    /// Control.
    ctrl,
    /// Option on macOS, Alt elsewhere.
    alt,
    /// ⌘ on macOS, the Windows key or Super elsewhere.
    platform,
  }

  /// Which mouse button.
  enum mouse-button {
    /// The main button.
    left,
    /// The secondary button.
    right,
    /// The middle button or wheel.
    middle,
  }

  /// A point in a node, in logical pixels from the node's top-left corner.
  record point {
    /// From the left edge.
    x: f32,
    /// From the top edge.
    y: f32,
  }

  /// A click.
  record click {
    /// The handler of the node's `click` listener.
    handler: handler,
    /// Which button.
    button: mouse-button,
    /// Keys held.
    modifiers: modifiers,
    /// 1 for a single click, 2 for a double click, and so on.
    count: u32,
    /// Where in the node (for a click from the keyboard: its centre).
    at: point,
  }

  /// What the pointer did. Later versions add cases at the end (a wheel,
  /// a pinch) without breaking tiles built for this one; a tile ignores
  /// cases it doesn't know.
  variant pointer-kind {
    /// A button went down.
    down(mouse-button),
    /// A button came up.
    up(mouse-button),
    /// The pointer moved (coalesced: the newest position).
    move,
    /// The wheel or a trackpad scrolled by this many pixels (positive `y`:
    /// the content moves up, as scrolling down; positive `x`: scrolling
    /// right). For a node with a `wheel` listener.
    wheel(delta),
    /// A trackpad pinch: zoom by this fraction (0.1: 10 % larger; -0.1:
    /// smaller), around `at`. For a node with a `wheel` listener.
    pinch(f32),
  }

  /// A pointer event over a node with a `pointer` listener. While a button
  /// is held after a `down` on the node, its moves and the `up` go to the
  /// same node even outside it (positions may then be negative or past
  /// its size).
  record pointer-event {
    /// The handler of the node's `pointer` listener.
    handler: handler,
    /// What happened.
    kind: pointer-kind,
    /// Where, from the node's top-left corner.
    at: point,
    /// Keys held.
    modifiers: modifiers,
  }

  /// A text field's new value.
  record input-change {
    /// The handler of the field's `change` listener.
    handler: handler,
    /// What the field holds now.
    value: string,
    /// The edit's revision. To replace the text later, send
    /// `input.revision` above it (runtime.md §2.4).
    revision: u64,
    /// The cursor or selection after the edit.
    selection: text-range,
  }

  /// A text field's cursor or selection moved, its value unchanged.
  record input-selection {
    /// The handler of the field's `select` listener.
    handler: handler,
    /// The cursor or selection now, in the value of the field's latest
    /// `input-changed` (or the value the tile last set).
    selection: text-range,
    /// The revision of the value it applies to.
    revision: u64,
  }

  /// A key binding fired.
  record key-event {
    /// The binding's handler.
    handler: handler,
    /// The binding's keys, as written in the keymap.
    keys: string,
  }

  /// Where a scroll container is scrolled to.
  record scroll-position {
    /// The handler of its `scroll` listener.
    handler: handler,
    /// Pixels scrolled from the left.
    x: f32,
    /// Pixels scrolled from the top.
    y: f32,
    /// The content's width, in pixels.
    content-width: f32,
    /// The content's height, in pixels.
    content-height: f32,
  }

  /// The pointer entered or left a node.
  record hover {
    /// The handler of the node's `hover` listener.
    handler: handler,
    /// True when it entered, false when it left.
    inside: bool,
    /// Where, from the node's top-left corner.
    at: point,
  }

  /// A size in logical pixels.
  record size {
    /// Width.
    width: f32,
    /// Height.
    height: f32,
  }

  /// A view's new size.
  record view-size {
    /// The view.
    view: view-id,
    /// Its size now.
    size: size,
  }

  /// Which node of a view has keyboard focus now.
  record node-focus {
    /// The view.
    view: view-id,
    /// The focused node's key path (keys from the root down, joined by
    /// `/`, without the root's, as `frame.focus`), or `none` when no node
    /// of the view has focus (the tile itself may still have it).
    key-path: option<string>,
  }

  /// Light or dark.
  enum theme-mode {
    /// The light theme.
    light,
    /// The dark theme.
    dark,
  }

  /// How much space Pitwall puts around things (Settings → Appearance).
  enum density {
    /// The most space.
    comfortable,
    /// The default.
    compact,
    /// The least space.
    dense,
  }

  /// The user's appearance settings that matter to a tile.
  record theme-info {
    /// Light or dark.
    mode: theme-mode,
    /// How much space to leave.
    density: density,
    /// The user asked for less motion: don't animate.
    reduce-motion: bool,
  }

  /// A toast's tone.
  enum tone {
    /// Neutral news.
    info,
    /// Something worked.
    good,
    /// Something needs attention.
    warn,
    /// Something failed.
    bad,
  }

  /// A row, tab, option or menu item chosen (`select`): in a virtual
  /// list, table or tree, a row clicked or moved to with the keys; in
  /// tabs, a select or a menu, the item chosen.
  record selection {
    handler: handler,
    /// The item's key: the row's, tab's, option's or menu item's.
    key: string,
    /// The row's index (lists, tables, trees), or the item's place among
    /// its siblings (tabs, options, menu items; separators not counted).
    index: u32,
    /// Keys held (⌘/Ctrl or Shift, to add to a selection).
    modifiers: modifiers,
    /// The row was activated: a double click, or Enter.
    activate: bool,
  }

  /// A tree's branch opened or closed, or a Markdown task ticked
  /// (`toggle`).
  record toggled {
    handler: handler,
    /// A tree: the row's key. Markdown: empty.
    key: string,
    /// A tree: the row's index. Markdown: the task's line in the text
    /// (0-based).
    index: u32,
    /// Open (or ticked) now.
    on: bool,
  }

  /// A link in Markdown clicked (`link`).
  record link-click {
    handler: handler,
    /// The link's target as written.
    url: string,
    modifiers: modifiers,
  }

  /// A table's header clicked to sort (`sort`): the column, and the
  /// direction asked for (the other way when it was sorted by it).
  record sort-change {
    handler: handler,
    column: string,
    direction: sort-direction,
  }

  /// A table's column resized by the user (`column-resized`), when the
  /// drag ends.
  record column-width {
    handler: handler,
    column: string,
    width: f32,
  }

  /// Something that happened, sent to `guest.handle`.
  variant event {
    /// A node with a `click` listener was clicked.
    click(click),
    /// A text field's value changed. Changes are coalesced: several
    /// between two calls arrive as one with the newest value, and Pitwall
    /// sends at most one per field every 50 ms while the user types, plus
    /// one when the field loses focus or submits, so a large text isn't
    /// sent on every keystroke.
    input-changed(input-change),
    /// A text field with a `select` listener moved its cursor or
    /// selection without changing its value (coalesced: the newest).
    input-selected(input-selection),
    /// Enter in a text field with a `submit` listener; carries its
    /// handler.
    submit(handler),
    /// A key binding of the frame's keymap fired.
    key(key-event),
    /// A scroll container with a `scroll` listener moved (coalesced: the
    /// newest position).
    scroll(scroll-position),
    /// The pointer entered or left a node with a `hover` listener.
    hover(hover),
    /// A press, release or move over a node with a `pointer` listener.
    pointer(pointer-event),
    /// A view's size changed (coalesced: the newest size).
    resize(view-size),
    /// The tile was shown (true) or hidden (false). While hidden, timers
    /// pause and nothing is rendered. `visibility(false)` is handled like
    /// any event: host calls made while handling it complete (storage
    /// writes reach the disk), and suspension starts when `handle`
    /// returns; a timer started then waits until the tile is shown.
    visibility(bool),
    /// The tile got (true) or lost (false) keyboard focus.
    focus(bool),
    /// The focus moved from one node of a view to another (a text field,
    /// a focusable node), or off the view's nodes: sent after the move,
    /// once per change. Leaving a text field this way is its blur (save
    /// what was typed). When the tile loses focus, this comes first with
    /// `none`, then `focus(false)`.
    focus-changed(node-focus),
    /// The user changed their appearance settings.
    theme(theme-info),
    /// A timer fired.
    timer(timer-id),
    /// The user changed the tile's settings; read them again with
    /// `settings.get`.
    settings-changed,
    /// The user granted or took back permissions; the list is what is
    /// granted now.
    grants-changed(list<string>),
    /// A view was opened; its first render follows. Every view gets this,
    /// the ones open at start too (right after `init`).
    view-opened(view-opened),
    /// An open view was given new content (a later call with the same
    /// content id); return true to render it again.
    view-content(view-content),
    /// A view was closed; it is no longer rendered.
    view-closed(view-id),
    /// A drag was dropped on a node with a `drop-target`.
    dropped(drop-event),
    /// A line number of a code or diff view with a `line-click` listener
    /// was clicked.
    line-clicked(line-click),
    /// The selection in a code or diff view with a `select` listener
    /// changed (coalesced: the newest, at most one every 100 ms).
    code-selected(code-selection),
    /// Pitwall's agents changed (one came or went; a name, a state or a
    /// Next up changed): read them again with `agents.list`. Only with
    /// `agents.read`; changes close together arrive as one.
    agents-changed,
    /// The user answered one of the tile's questions (`asks.set`), in the
    /// floating control. Reply with `asks.reply`.
    ask-answered(ask-answer),
    /// A row, tab, option or menu item was chosen.
    select(selection),
    /// A tree's branch opened or closed; a Markdown task ticked.
    toggle(toggled),
    /// A link in Markdown was clicked.
    link(link-click),
    /// A table's header was clicked to sort.
    sort(sort-change),
    /// A table's column was resized.
    column-resized(column-width),
    /// The answer to a `net.fetch` request (or why there is none).
    fetched(fetched),
    /// The extension's toolbar button was clicked (its action is `tile` or
    /// `popover`): the id of the project whose space the window shows, if
    /// any (for a per-project item).
    toolbar-clicked(option<string>),
    /// The extension's own server changed state (`service.info`).
    service-changed(service-info),
    /// A control with a `value` listener was changed by the user.
    value-changed(value-change),
    /// A node with a `dismiss` listener was closed or removed by the user;
    /// carries its handler.
    dismissed(handler),
    /// The user pressed Undo on what agent call `u64` (a `present` call's
    /// `content.call`) put in the tile: restore what was there before it,
    /// or remove the item if the call created it.
    undo-present(u64),
    /// A `read` or `act` call the tile didn't answer in time was given up
    /// (the agent was told): stop working on it; a `reply` to it is
    /// dropped.
    tool-cancelled(u64),
  }

  /// What the tile gets when it starts.
  record init-context {
    /// The extension's id.
    extension: string,
    /// The extension's version, from its manifest.
    version: string,
    /// The user's appearance settings.
    theme: theme-info,
    /// The permissions the user granted, by name.
    granted: list<string>,
    /// What `guest.save-state` returned before the tile was last dropped
    /// (to save memory while hidden, or for a reload during development);
    /// `none` on a fresh start.
    state: option<list<u8>>,
  }

  /// An amount moved, in logical pixels.
  record delta {
    /// Rightwards.
    x: f32,
    /// Downwards.
    y: f32,
  }

  /// What a node can be dragged as, inside its view.
  record drag-source {
    /// A kind of the tile's own (`"card"`, `"column"`): drop targets name
    /// the kinds they accept.
    kind: string,
    /// What the drop target gets back (an item's id, JSON). At most 64 KiB.
    data: string,
    /// Shown in the chip under the pointer while dragging.
    label: string,
  }

  /// A place drags can be dropped on.
  record drop-target {
    /// The kinds of drag it takes (`drag-source.kind`).
    accepts: list<string>,
    /// The handler `dropped` carries.
    handler: handler,
  }

  /// A drag dropped on a drop target.
  record drop-event {
    /// The target's handler.
    handler: handler,
    /// The dragged node's kind.
    kind: string,
    /// The dragged node's data.
    data: string,
    /// Where it was dropped, from the target's top-left corner.
    at: point,
  }

  /// A colour in a canvas: one of the theme's tokens (best: the drawing
  /// follows light and dark and the user's theme), or a fixed colour.
  variant paint {
    /// A theme colour.
    token(token),
    /// A fixed colour, `0xRRGGBBAA`. The same in both themes.
    rgba(u32),
  }

  /// A rectangle, in logical pixels.
  record rect {
    /// Its left edge.
    x: f32,
    /// Its top edge.
    y: f32,
    /// Its width.
    width: f32,
    /// Its height.
    height: f32,
  }

  /// How a line is drawn.
  record stroke {
    /// Its colour.
    color: paint,
    /// Its width, in logical pixels (scaled with the canvas's transform).
    width: f32,
    /// A dash pattern: lengths drawn and left out, in turn (`[4, 3]`);
    /// empty for a solid line. At most 16 lengths.
    dash: list<f32>,
  }

  /// A rectangle drawn in a canvas.
  record draw-rect {
    /// Where.
    rect: rect,
    /// Its fill, if any.
    fill: option<paint>,
    /// Its outline, if any.
    stroke: option<stroke>,
    /// Its corner radius, in logical pixels.
    radius: f32,
  }

  /// A quadratic curve's step.
  record quad-to {
    /// The control point.
    control: point,
    /// Where it ends.
    to: point,
  }

  /// A cubic curve's step.
  record cubic-to {
    /// The first control point.
    control1: point,
    /// The second control point.
    control2: point,
    /// Where it ends.
    to: point,
  }

  /// One step of a path.
  variant path-step {
    /// Start a new piece here.
    move-to(point),
    /// A straight line to here.
    line-to(point),
    /// A quadratic curve.
    quad-to(quad-to),
    /// A cubic curve.
    cubic-to(cubic-to),
    /// A line back to the piece's start.
    close,
  }

  /// A path drawn in a canvas: lines and curves, filled or stroked.
  record draw-path {
    /// Its steps, starting with `move-to`.
    steps: list<path-step>,
    /// Its fill, if any.
    fill: option<paint>,
    /// Its line, if any.
    stroke: option<stroke>,
  }

  /// Where text lies across its point.
  enum text-align {
    /// It starts at the point.
    start,
    /// It is centred on the point.
    center,
    /// It ends at the point.
    end,
  }

  /// Where text lies up and down from its point.
  enum text-baseline {
    /// Its line's top is at the point.
    top,
    /// Its line's middle is at the point.
    middle,
    /// Its line's bottom is at the point.
    bottom,
  }

  /// One line of text drawn in a canvas, shaped by Pitwall in its fonts.
  record draw-text {
    /// The text (one line: line breaks are drawn as spaces).
    text: string,
    /// Where, as `align` and `baseline` say.
    at: point,
    /// Its size in logical pixels (scaled with the canvas's transform).
    /// Pitwall's body text is 13; its other sizes 11, 12, 16 and 20.
    size: f32,
    /// Its colour.
    color: paint,
    /// Its font.
    font: font,
    /// Its weight.
    weight: weight,
    /// Across the point.
    align: text-align,
    /// Up and down from the point.
    baseline: text-baseline,
    /// The widest it may be, in the canvas's coordinates: longer text is
    /// cut with an ellipsis.
    max-width: option<f32>,
  }

  /// One thing a canvas draws, in order (later on top).
  variant draw-op {
    /// A rectangle.
    rect(draw-rect),
    /// A path.
    path(draw-path),
    /// Text.
    text(draw-text),
    /// Draw only inside this rectangle until the matching `clip-pop`.
    clip-push(rect),
    /// End the newest `clip-push`.
    clip-pop,
  }

  /// How a canvas's coordinates map to its node: a point (x, y) is drawn
  /// at (x × scale + dx, y × scale + dy) from the node's top-left corner.
  /// Ops and regions are given in the canvas's coordinates; events come in
  /// the node's.
  record transform {
    /// The zoom (1.0: as given).
    scale: f32,
    /// Moved right by this.
    dx: f32,
    /// Moved down by this.
    dy: f32,
  }

  /// A clickable area of a canvas, over what it draws: a box of a diagram.
  /// Screen readers read its label (accessible structure inside a canvas).
  record hit-region {
    /// Stable among the canvas's regions, at most 128 bytes.
    key: string,
    /// Where, in the canvas's coordinates.
    rect: rect,
    /// Its accessible name, and its tooltip unless it has one.
    label: string,
    /// Text shown when the pointer rests on it.
    tooltip: option<string>,
    /// Sent as a `click` event (its `at` from the canvas node's corner).
    click: option<handler>,
    /// Sent as a `hover` event when the pointer enters or leaves it.
    hover: option<handler>,
  }

  /// A drawing. At most 20 000 ops and 5 000 regions.
  record canvas {
    /// What it draws, in order.
    ops: list<draw-op>,
    /// How its coordinates map to the node (zoom and pan).
    transform: transform,
    /// Its clickable areas; where they overlap, the last one listed wins.
    regions: list<hit-region>,
  }

  /// A range of lines, 0-based (`start` ≤ `end`, `end` exclusive).
  record line-range {
    /// The first line.
    start: u32,
    /// The line after the last.
    end: u32,
  }

  /// What a line mark says, drawn in the margin as Pitwall's editor marks
  /// changes since the last commit.
  enum line-mark-kind {
    /// Added lines (a green bar).
    added,
    /// Changed lines (a blue bar).
    changed,
    /// Lines were deleted before `start` (a red mark between lines).
    deleted,
    /// An error on these lines (a red bar, the lines tinted, its
    /// `message` at the end of the first line).
    error,
    /// A warning on these lines (a yellow bar, the lines tinted, its
    /// `message` at the end of the first line).
    warning,
  }

  /// A mark in a code view's margin.
  record line-mark {
    /// Which lines.
    lines: line-range,
    /// What it says.
    kind: line-mark-kind,
    /// For an error or a warning: what is wrong, drawn after the first
    /// line's text (at most 500 bytes; longer is cut). Ignored for the
    /// other kinds.
    message: option<string>,
  }

  /// Pitwall's read-only code view, showing the tile's text. The text is
  /// sent in each frame (at most 1 MiB); a frame with the same text and
  /// language keeps the user's scroll position and selection.
  record code-view {
    /// The text.
    text: string,
    /// Its language, for highlighting: a name (`rust`, `typescript`,
    /// `python`, `markdown`, …) or a file name (`main.rs`); `none` or an
    /// unknown one: plain text.
    language: option<string>,
    /// Marks in the margin.
    marks: list<line-mark>,
    /// Scroll this line (0-based) into the middle and put the cursor on
    /// it, when it differs from the last frame's.
    reveal: option<u32>,
  }

  /// Which version of a diff.
  enum diff-side {
    /// The original (left, or the removed lines).
    old,
    /// The changed version (right, or the added lines). A code view's
    /// lines are this side.
    new,
  }

  /// How a diff is laid out.
  enum diff-layout {
    /// Old on the left, new on the right.
    side-by-side,
    /// One column, removed lines above added ones.
    inline,
  }

  /// Both versions of a text.
  record diff-texts {
    /// The original.
    old: string,
    /// The changed version.
    new: string,
  }

  /// What a diff view compares.
  variant diff-source {
    /// Two whole texts (each at most 1 MiB): unchanged runs fold.
    texts(diff-texts),
    /// A unified diff of one file (`git diff` output: `@@` hunks, `+`,
    /// `-` and context lines; header lines are skipped), at most 1 MiB.
    /// Lines keep their numbers from the hunk headers; what the diff
    /// doesn't show is folded.
    unified(string),
  }

  /// Pitwall's diff view, as Review draws a file's changes: line and
  /// character changes, folded unchanged runs.
  record diff-view {
    /// What it compares.
    source: diff-source,
    /// The language, as `code-view.language` takes it.
    language: option<string>,
    /// Side by side or inline.
    layout: diff-layout,
    /// Scroll this line of the new version (0-based) into the middle, when
    /// it differs from the last frame's.
    reveal: option<u32>,
  }

  /// A line number of a code or diff view was clicked.
  record line-click {
    /// The handler of the view's `line-click` listener.
    handler: handler,
    /// Which version's line (`new` in a code view).
    side: diff-side,
    /// The line, 0-based.
    line: u32,
  }

  /// A place in a code or diff view's text.
  record text-pos {
    /// The line, 0-based.
    line: u32,
    /// The column, in UTF-8 bytes from the line's start.
    column: u32,
  }

  /// The selection in a code or diff view.
  record code-selection {
    /// The handler of the view's `select` listener.
    handler: handler,
    /// Which version it is in (`new` in a code view).
    side: diff-side,
    /// Where it starts (the earlier end).
    start: text-pos,
    /// Where it ends; equal to `start` for a bare cursor.
    end: text-pos,
    /// The selected text, cut at 64 KiB.
    text: string,
  }

  /// An answer to one of the tile's questions (`asks.set`).
  record ask-answer {
    /// The question's id.
    id: string,
    /// The suggestions picked, by their place in its list (from 0).
    picks: list<u32>,
    /// What the user typed, when anything.
    text: option<string>,
    /// The user declined to answer.
    declined: bool,
  }

  // ---- Components, batch 2: form controls, feedback, layout, data
  // display and charts (ui.md §3.10). Drawn with Pitwall's own kit, so a
  // tile's controls are the app's controls ("kit parity"). Controls are
  // controlled: the frame says the value, the user's change arrives as
  // `value-changed`, and the tile's next frame shows it.

  /// A control's new value, as `value-changed` carries it.
  variant control-value {
    /// A checkbox or switch is on (true) or off; a disclosure is open.
    on(bool),
    /// A slider's, number field's or split's number (a split's: the
    /// first pane's share, 0.0–1.0).
    number(f64),
    /// The key of the radio button, segment, breadcrumb or timeline
    /// segment chosen.
    choice(string),
    /// A number field was emptied.
    empty,
  }

  /// A control's value changed (`value`).
  record value-change {
    /// The handler of the node's `value` listener.
    handler: handler,
    /// What it is now.
    value: control-value,
  }

  /// A checkbox or a switch. A click on it or its label, or Space while it
  /// has focus, sends `value-changed` with `on` and the other state;
  /// without a `value` listener it can't be changed.
  record check {
    /// Its label, drawn after the box (or before the switch); empty for
    /// none (then give the node a `label`, its accessible name).
    label: string,
    /// On.
    checked: bool,
    /// A checkbox that stands for a group of which only some are on:
    /// drawn with a dash. A click sends `on(true)`.
    mixed: bool,
    /// Drawn dimmed; takes no clicks and no focus.
    disabled: bool,
  }

  /// One choice of a radio group or a segmented control.
  record choice-item {
    /// Its key, sent in `value-changed` (`choice`). Unique in the group,
    /// at most 128 bytes.
    key: string,
    /// What it says.
    label: string,
    /// Drawn dimmed and can't be chosen.
    disabled: bool,
  }

  /// One of several choices: a radio group (a column, or a row when
  /// `horizontal`) or a segmented control. One focus stop: the arrow keys
  /// move to the next choice and choose it, Home and End to the first and
  /// last. At most 64 choices.
  record choice-group {
    /// The choices, in order.
    items: list<choice-item>,
    /// The chosen one's key; `none`: none yet.
    selected: option<string>,
    /// A radio group laid out in a row (a segmented control always is).
    horizontal: bool,
    /// The whole group is dimmed and can't be changed.
    disabled: bool,
  }

  /// A slider. Dragging moves it at once; `value-changed` follows as it
  /// moves (at most one every 50 ms) and when it is let go. Left and Down
  /// step down, Right and Up step up, Page Up and Page Down by a tenth,
  /// Home and End to the ends.
  record slider {
    /// Its value, kept between `min` and `max`.
    value: f64,
    /// The lowest value.
    min: f64,
    /// The highest value (above `min`).
    max: f64,
    /// The steps it snaps to (0: none; the keys then move a hundredth).
    step: f64,
    /// Draw the value at its right.
    show-value: bool,
    /// Dimmed and can't be changed.
    disabled: bool,
  }

  /// A number field. Typing a number and pressing Enter (or leaving the
  /// field) sends `value-changed` with it, kept within `min` and `max` and
  /// rounded to `decimals`; text that isn't a number is put back. − and +
  /// (and Up and Down while it has focus) step by `step`.
  record number-field {
    /// What it shows; `none`: empty.
    value: option<f64>,
    /// The lowest value it takes.
    min: option<f64>,
    /// The highest value it takes.
    max: option<f64>,
    /// What − and + add (above 0; 1 is usual).
    step: f64,
    /// Digits after the point, 0–6.
    decimals: u8,
    /// Shown in faint text while it is empty.
    placeholder: option<string>,
    /// Shown, selectable, but not changed (no steps).
    readonly: bool,
    /// Dimmed and can't be changed or focused.
    disabled: bool,
  }

  /// A search field: one line of text with a magnifier before it and a
  /// clear button while it holds text. It is a text field (`input`):
  /// Pitwall owns what is typed, `change` and `submit` listeners hear it
  /// as they do from `input`, and the clear button sends `input-changed`
  /// with an empty value.
  record search-field {
    /// Text to put in it, as `input.value` (`none` keeps what it holds).
    value: option<string>,
    /// The revision of `value`, as `input.revision`.
    revision: u64,
    /// Shown in faint text while it is empty (default: "Search").
    placeholder: option<string>,
    /// Dimmed and can't be edited.
    disabled: bool,
  }

  /// A form row: its label over its children (the control), or beside
  /// them, with help text under them, and a validation message in place
  /// of the help while there is one. The label is the control's
  /// accessible name when the control has none.
  record form-row {
    /// The label.
    label: string,
    /// Help under the control, in muted text.
    help: option<string>,
    /// A validation message, in red, in place of the help; the control is
    /// marked invalid.
    error: option<string>,
    /// A required field: a mark after the label.
    required: bool,
    /// The label beside the control (a fixed column) instead of over it.
    inline: bool,
  }

  /// A progress bar.
  record progress {
    /// The share done, 0.0–1.0; `none` while it can't be known (a bar
    /// that moves, or a still one with Reduce motion).
    value: option<f32>,
    /// Its colour by meaning (`none`: the text colour).
    tone: option<tone>,
  }

  /// A grey placeholder where content is loading, sized by the node's
  /// styles (a `block` without a size is a line tall and fills the row).
  /// It shimmers unless Reduce motion is on.
  variant skeleton {
    /// This many lines of text (1–20), the last one shorter.
    lines(u8),
    /// A box (give it a size).
    block,
    /// A circle (an avatar), as tall as its width.
    circle,
  }

  /// An empty state, centred in its box: an icon, a title, a line of
  /// text and an action button, as Pitwall's own lists say they're empty.
  /// The action's click is the node's `click` listener.
  record empty-state {
    /// An icon over the title.
    icon: option<icon>,
    /// What is empty ("No runs yet").
    title: string,
    /// What to do about it.
    text: option<string>,
    /// The action button's label (needs a `click` listener).
    action: option<string>,
  }

  /// An inline banner in the tile's flow (not a toast). Its action's
  /// click is the node's `click` listener; its close button (when
  /// `dismissible`) sends `dismissed`.
  record banner {
    /// Information (`info`), success (`good`), a warning (`warn`) or an
    /// error (`bad`).
    tone: tone,
    /// A bold first line.
    title: option<string>,
    /// The message.
    text: string,
    /// An action button's label (needs a `click` listener).
    action: option<string>,
    /// It has a close button (needs a `dismiss` listener).
    dismissible: bool,
  }

  /// A small count or status label, as Pitwall's own.
  record badge {
    /// What it says ("3", "beta"); at most 32 bytes.
    text: string,
    /// Its colour by meaning (`none`: neutral).
    tone: option<tone>,
  }

  /// A chip (a tag). With a `click` listener it can be picked (drawn
  /// `selected`); `removable` gives it a × that sends `dismissed` (as do
  /// Backspace and Delete while it has focus).
  record chip {
    /// What it says.
    label: string,
    /// An icon before the label.
    icon: option<icon>,
    /// Its colour by meaning (`none`: neutral).
    tone: option<tone>,
    /// Drawn picked.
    selected: bool,
    /// It has a ×.
    removable: bool,
    /// Dimmed; takes no clicks.
    disabled: bool,
  }

  /// Which way something runs.
  enum orientation {
    /// Left to right.
    horizontal,
    /// Top to bottom.
    vertical,
  }

  /// Two panes (the node's first two children) with a bar between them
  /// that the user drags. Pitwall keeps the user's size for the view by
  /// the node's key path, across restarts, and sends it as `value-changed`
  /// (`number`: the first pane's share) when a drag ends.
  record split {
    /// Side by side (`horizontal`) or one above the other.
    orientation: orientation,
    /// The first pane's share at first, 0.05–0.95.
    initial: f32,
    /// The first pane's smallest size, in logical pixels.
    min-first: f32,
    /// The second pane's smallest size, in logical pixels.
    min-second: f32,
  }

  /// A section with a header that opens and closes it: the header is
  /// a button (Enter or Space while it has focus) that sends
  /// `value-changed` with `on` and the other state; the node's children
  /// are drawn under it while `open`.
  record disclosure {
    /// The header.
    title: string,
    /// Muted text at the header's right (a count, a summary).
    detail: option<string>,
    /// Open.
    open: bool,
  }

  /// A card: a bordered box on the raised surface with its children in
  /// it, under a title when it has one. With a `click` listener the whole
  /// card is clickable and focusable.
  record card {
    /// A title at its top.
    title: option<string>,
    /// Muted text at the title's right.
    detail: option<string>,
  }

  /// One level of breadcrumbs.
  record crumb {
    /// Its key, sent in `value-changed` (`choice`).
    key: string,
    /// What it says.
    label: string,
  }

  /// Where a popover opens from its anchor.
  enum placement {
    /// Under it (the default place).
    below,
    /// Over it.
    above,
    /// At its left.
    start,
    /// At its right.
    end,
  }

  /// A popover: the node's children in a floating panel anchored to the
  /// node's parent, drawn by Pitwall inside the tile and kept in the
  /// window. It is open while it is in the frame. Esc and a click outside
  /// it send `dismissed` (the tile then leaves it out). At most one a
  /// frame.
  record popover {
    /// Where it opens.
    placement: placement,
    /// Its width in logical pixels (`none`: its content's, 160–480).
    width: option<f32>,
    /// Anchor it to this point of its parent instead of the parent's
    /// edge, in logical pixels from the parent's top-left corner (as a
    /// `click`'s `at`): under a box of a canvas, say. `placement` then
    /// says which side of the point it opens on. `none`: the parent's
    /// edge, as before.
    at: option<point>,
  }

  /// A sheet over the tile asking the user to confirm, in place of the
  /// system dialogs a tile can't open. Shown while it is in the frame;
  /// the rest of the tile is dimmed and takes no input. Its confirm
  /// button is the node's `click` listener (Enter); Cancel, Esc and a
  /// click on the dimmed tile send `dismissed`. At most one a frame.
  record confirm-sheet {
    /// The question ("Delete 3 notes?").
    title: string,
    /// More about it.
    text: option<string>,
    /// The confirm button's label ("Delete").
    confirm: string,
    /// The cancel button's label (`none`: "Cancel").
    cancel: option<string>,
    /// A destructive action: the confirm button is red.
    danger: bool,
  }

  /// One line of a key-value list.
  record key-value {
    /// The label ("Branch").
    key: string,
    /// The value ("main").
    value: string,
    /// The value in the monospace font (ids, hashes, paths).
    mono: bool,
    /// The value has a copy button.
    copyable: bool,
  }

  /// An avatar's size.
  enum avatar-size {
    /// 20 px.
    small,
    /// 28 px.
    medium,
    /// 40 px.
    large,
  }

  /// An avatar: the initials of `name` in a circle, coloured from the
  /// theme by the name, so a person has the same colour everywhere. Its
  /// accessible name and tooltip are `name` unless the node has its own.
  record avatar {
    /// The person's or thing's name ("Ada Lovelace": AL).
    name: string,
    /// Its size.
    size: avatar-size,
  }

  /// A time, drawn relative to now ("just now", "5 min ago", "3 h ago",
  /// "yesterday", then the date) and kept up to date by Pitwall, so the
  /// tile needs no timer. Its tooltip is the date and time in full.
  record relative-time {
    /// The time, in milliseconds since 1970-01-01 UTC.
    at: s64,
  }

  /// Text with a copy button. Pitwall writes the text to the clipboard
  /// only when the user clicks the button (or presses Enter while it has
  /// focus), and says "Copied"; a `click` listener hears it too.
  record copyable {
    /// The text shown and copied (at most 64 KiB).
    text: string,
    /// In the monospace font.
    mono: bool,
  }

  /// A link. With `url` (https, or http on this computer) and the `show`
  /// permission, a click opens the page in a Pitwall web tile, as
  /// `web.open` does; otherwise it is the node's `click` listener (a
  /// link to somewhere in the tile).
  record link {
    /// What it says.
    label: string,
    /// The page it opens.
    url: option<string>,
  }

  /// A series of a chart.
  record chart-series {
    /// Its name, in the legend and tooltips.
    name: string,
    /// Its values, one per label (a NaN or infinite value is a gap).
    values: list<f64>,
    /// Its colour (`none`: the next of Pitwall's chart colours).
    color: option<token>,
  }

  /// A sparkline: a small line without axes, sized by the node's styles
  /// (default 80 × 20).
  record sparkline {
    /// The values, oldest first (at most 1 000).
    values: list<f64>,
    /// Its colour (`none`: the text colour).
    color: option<token>,
    /// The area under the line is filled, faintly.
    filled: bool,
  }

  /// A bar chart: one group of bars per label, one bar per series in it
  /// (or one stacked bar), with a value axis, and a tooltip per bar.
  record bar-chart {
    /// The labels along the bottom (at most 200).
    labels: list<string>,
    /// The series (at most 8), each with one value per label.
    series: list<chart-series>,
    /// Stack the series in one bar per label.
    stacked: bool,
    /// The values' unit, in the axis and tooltips ("ms", "%").
    unit: option<string>,
  }

  /// A line chart: one line per series over the labels, with axes and a
  /// tooltip on hover that lists each series' value at the label under
  /// the pointer.
  record line-chart {
    /// The labels along the bottom (at most 1 000; Pitwall draws as many
    /// as fit).
    labels: list<string>,
    /// The series (at most 8), each with one value per label.
    series: list<chart-series>,
    /// The values' unit, in the axis and tooltips.
    unit: option<string>,
    /// The axis's lowest value (`none`: from the data, or 0).
    min: option<f64>,
    /// The axis's highest value (`none`: from the data).
    max: option<f64>,
  }

  /// One segment of a status timeline.
  record timeline-segment {
    /// Its key, sent in `value-changed` (`choice`) when it is clicked.
    key: string,
    /// Its tooltip and accessible name ("#412 passed in 3 min").
    label: string,
    /// Its colour by meaning (`none`: neutral, as for a run not started).
    tone: option<tone>,
    /// Its width relative to the others (a run's duration; 1.0 for all
    /// alike).
    weight: f32,
  }

  /// A status timeline: a row of coloured segments, oldest first, each
  /// with a tooltip, as a CI tile shows its last runs. At most 500.
  record status-timeline {
    /// The segments.
    segments: list<timeline-segment>,
  }
}
