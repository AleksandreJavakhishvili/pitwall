package pitwall:tile@0.1.0;

/// Requests about the tile's own views (runtime.md §3.8). No permission:
/// these act only inside the tile's own area of the window.
interface ui {
  use types.{view-id, tone};

  /// Render `view` again once the current call returns (when it is
  /// hidden: once it is shown). For changes that didn't come from an
  /// event, since `handle` returning true already renders.
  request-render: func(view: view-id);

  /// Scroll the scroll containers around the node at `key-path` (keys
  /// from the root down, joined by `/`, without the root's, as
  /// `frame.focus`) so the node is in sight, after the next render of
  /// `view`. A path with no node is ignored.
  scroll-to: func(view: view-id, key-path: string);

  /// Show a short message in a toast, labelled with the tile's name. At
  /// most 200 characters (longer text is cut); at most 3 toasts a
  /// minute, more are dropped and noted in the Log.
  toast: func(text: string, tone: tone);

  /// Open one of the extension's tiles (an id from its manifest's
  /// `contributes.tiles`) where Pitwall opens tiles, or focus its view
  /// when one is already open; a `view-opened` event follows. An unknown
  /// id is ignored and noted in the Log.
  open-view: func(tile: string);

  use types.{host-error};

  /// Hand Pitwall an image's bytes (PNG, JPEG, GIF, WebP or SVG; at most
  /// 8 MiB) under `name`, for `image` nodes with source `data(name)`.
  /// Kept until replaced or dropped; at most 64 MiB for all a tile's
  /// images. `invalid` when the bytes aren't one of those formats;
  /// `too-large` over a limit.
  put-image: func(name: string, bytes: list<u8>) -> result<_, host-error>;

  /// Forget the image put under `name`.
  drop-image: func(name: string);

  use types.{font, weight};

  /// How wide each of `texts` is on one line in Pitwall's `font` (Inter
  /// for `ui`, JetBrains Mono for `mono`) at `size` logical pixels (4–200)
  /// and `weight`, in logical pixels: to size boxes on a canvas around
  /// their labels. Kerned as Pitwall draws it; a character Pitwall's font
  /// lacks counts as an average letter. One width per text, in order; at
  /// most 1 000 texts and 64 KiB in all a call (more: an empty list,
  /// noted in the Log). The same numbers in the test harness.
  measure-text: func(texts: list<string>, font: font, size: f32, weight: weight) -> list<f32>;
}
