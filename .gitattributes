# Keep line endings identical on every OS. Test fixtures (captured terminal
# screens, JSON, transcripts) must stay byte-for-byte LF, or Windows checkouts
# with core.autocrlf turn "\n" into "\r\n" and break the comparisons.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.webp binary
*.ico binary
*.icns binary
*.mp4 binary
*.woff2 binary
