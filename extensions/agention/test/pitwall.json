{
  "about": "What Pitwall's tests expect of this extension (crates/pitwall-app checks every folder under extensions/ against its test/pitwall.json). Nothing here runs a real agent or server.",
  "actions": {
    "installed": ["claude", "npm"],
    "expect": {
      "setup": {
        "label": "Set up Agention in my agents",
        "lines": [
          "claude plugin marketplace remove agention",
          "claude plugin marketplace add WayfarerLabs/agention#v0.6.0",
          "claude plugin install agention@agention",
          "codex plugin marketplace remove agention",
          "codex plugin marketplace add WayfarerLabs/agention --ref v0.6.0",
          "codex plugin add agention@agention"
        ],
        "skips": [null, null, null, "Codex isn't installed", "Codex isn't installed", "Codex isn't installed"],
        "optional": [true, false, false, true, false, false]
      },
      "server": {
        "label": "Install Agention's server here",
        "lines": ["npm install -g @wayfarerlabs/agention@0.6.0"],
        "skips": [null],
        "optional": [false]
      }
    }
  },
  "env": {
    "unset": [
      "AGENTION_URL (not set until Server address is)",
      "AGENTWORKS_AGENT={project}",
      "AGENTWORKS_SESSION={agent_id}"
    ],
    "values": { "server": "https://agention.example.ts.net" },
    "set": [
      "AGENTION_URL=https://agention.example.ts.net",
      "AGENTWORKS_AGENT={project}",
      "AGENTWORKS_SESSION={agent_id}"
    ]
  },
  "service": {
    "values": { "server": "https://agention.example.ts.net" },
    "expect": {
      "run": "agention serve --data {data} --origin https://agention.example.ts.net --listen 127.0.0.1:8787",
      "version": "agention version",
      "firstRun": "agention passkey-link --data {data} --origin https://agention.example.ts.net"
    },
    "cases": [
      { "version": "agention 0.6.0", "verdict": "starts (Agention's server 0.6.0)" },
      { "version": "0.5.0", "verdict": "Agention's server 0.5.0; this extension needs 0.6.0 or later: its install action is offered" },
      { "installed": false, "verdict": "“agention” isn't installed: its install action is offered" },
      { "portTaken": true, "verdict": "something else is already listening on 127.0.0.1:8787: that one is used, nothing is started" },
      { "installed": false, "portTaken": true, "verdict": "something else is already listening on 127.0.0.1:8787: that one is used, nothing is started" },
      { "values": { "server": "" }, "verdict": "waits for Server address to be set" },
      { "values": { "server": "https://agention.example.ts.net", "listen": "0.0.0.0:8787" }, "verdict": "isn't started: “0.0.0.0:8787” isn't on this computer only: use 127.0.0.1 and a port" }
    ]
  },
  "agreement": {
    "fake": ["node", "adapter/test/serve-fake.mjs"],
    "settings": { "server": "{url}" },
    "secrets": { "apiKey": "{key}" },
    "answer": { "pick": 1, "label": "SQLite", "text": "in the data dir" }
  }
}
