{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pitwall",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "externalBin": [
      "binaries/pitwall-hold",
      "binaries/pitwall-cli",
      "binaries/pitwall-hook"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
