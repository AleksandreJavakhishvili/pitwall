{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "pitwall-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    "notification:default",
    "dialog:allow-open"
  ]
}
