{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitwall",
  "version": "0.1.1",
  "identifier": "dev.pitwall.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pitwall",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pitwall-hold",
      "binaries/pitwall-cli"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Hosts terminal coding agents and shows who needs you",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["curl"]
      }
    }
  }
}
